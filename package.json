  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "tsx": "^4.20.6",
    "@types/node": "^22.18.0"
  }
}
